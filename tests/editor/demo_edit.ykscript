# Edits the demo game's level (a private copy) with the scene-view tools, the hierarchy and
# the dialogs: selection, links, door target handles, marquee, copy/paste, reparenting, rotation,
# prefabs, unsaved-changes prompts, project settings and validation.
timeout 300
expect entity-count 173
expect clean

log "== links and target handles"
click "hierarchy/Lever"
expect selected Lever
expect links Lever Gate
click "hierarchy/Gate"
expect selected Gate
expect widget scene/handle/Ghost0
expect prop Gate Door.openOffset 0,-3.2
drag scene/handle/Ghost0 world:19,11
expect prop Gate Door.openOffset 0,-4.5
expect undo "Move Target"
capture ${SHOT_DIR}/edit-01-ghost.bmp
key ctrl+z
expect prop Gate Door.openOffset 0,-3.2
expect clean

log "== marquee selection"
drag world:4.5,12 world:9.5,17.5
expect selection-at-least 4
expect clean
key escape

log "== resize a door, undo, redo"
click "hierarchy/Gate"
click toolbar/Resize
expect widget scene/handle/Right
drag scene/handle/Right world:20.5,15.5
expect size Gate 2,3
expect position Gate 19.5,15.5
expect dirty
key ctrl+z
expect size Gate 1,3
key ctrl+y
expect size Gate 2,3
key ctrl+z
expect clean
click toolbar/Move

log "== rotate"
click "hierarchy/Water Ledge A"
click toolbar/Rotate
expect widget scene/handle/Rotate
drag scene/handle/Rotate world:28.55,15.4
expect prop "Water Ledge A" Transform.rotation 90
capture ${SHOT_DIR}/edit-02-rotated.bmp
key ctrl+z
expect prop "Water Ledge A" Transform.rotation 0
click toolbar/Move

log "== copy, paste, duplicate"
click "hierarchy/Plate Near"
key ctrl+c
key ctrl+v
expect entity "Plate Near (1)"
expect entity-count 175
key ctrl+z
expect no-entity "Plate Near (1)"
click "hierarchy/Plate Near"
key ctrl+d
expect entity "Plate Near (1)"
key delete
expect no-entity "Plate Near (1)"
expect entity-count 173
key ctrl+z
key ctrl+z
expect clean

log "== reparent by dragging in the hierarchy"
drag "hierarchy/Lever" "hierarchy/Checkpoint"
expect parent Lever Checkpoint
key ctrl+z
expect parent Lever Mechanisms
expect clean

log "== rename in the hierarchy"
click "hierarchy/Checkpoint"
key f2
wait 3
type "Save Point"
wait 1
key enter
expect entity "Save Point"
expect no-entity Checkpoint
key ctrl+z
expect entity Checkpoint

log "== editing several entities at once"
click "hierarchy/Ground Start"
click "hierarchy/Ground Middle" ctrl
expect selection-at-least 2
expect widget prop/order
edit prop/order 5
expect prop "Ground Start" SpriteRenderer.order 5
expect prop "Ground Middle" SpriteRenderer.order 5
expect dirty
capture ${SHOT_DIR}/edit-03-multi.bmp
key ctrl+z
expect prop "Ground Start" SpriteRenderer.order 0
expect prop "Ground Middle" SpriteRenderer.order 0
expect clean
key escape

log "== reorder siblings from the keyboard and the Entity menu"
click "hierarchy/Gate"
expect sibling-index Gate 1
key alt+up
expect sibling-index Gate 0
expect undo "Reorder"
key alt+down
expect sibling-index Gate 1
menu "Entity/Move Down"
expect sibling-index Gate 2
menu "Entity/Move Up"
expect sibling-index Gate 1
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
expect sibling-index Gate 1
expect clean

log "== prefab instances: revert, apply, unpack"
click "hierarchy/Lever"
expect widget inspector/prefab/revert
expect widget inspector/prefab/apply
expect links Lever Gate
edit prop/cooldown 3
expect prop Lever Lever.cooldown 3
click inspector/prefab/revert
expect prop Lever Lever.cooldown 0.4
expect undo "Revert to Prefab"
expect links Lever Gate
key ctrl+z
expect prop Lever Lever.cooldown 3
# Apply writes the prefab file, and the console says so.
expect file-lacks prefabs/mechanisms/lever.ykprefab "\"cooldown\": 3"
click inspector/prefab/apply
expect file-contains prefabs/mechanisms/lever.ykprefab "\"cooldown\": 3"
expect console "Applied 'Lever'"
key ctrl+z
key ctrl+z
expect prop Lever Lever.cooldown 0.4
expect clean
# Other instances only follow when asked, and the dialog says how many.
click "hierarchy/Grass 1"
expect widget inspector/prefab/update
edit prop/color "#ff0000ff"
click inspector/prefab/apply
expect console "Applied 'Grass 1'"
expect prop-not "Grass 2" SpriteRenderer.color "#ff0000ff"
click inspector/prefab/update
expect dialog confirm
click dialog/Confirm/cancel
expect no-dialog
expect prop-not "Grass 2" SpriteRenderer.color "#ff0000ff"
menu "Entity/Prefab/Update Other Instances"
expect dialog confirm
click dialog/Confirm/ok
expect no-dialog
expect prop "Grass 2" SpriteRenderer.color "#ff0000ff"
expect undo "Update Prefab Instances"
key ctrl+z
expect prop-not "Grass 2" SpriteRenderer.color "#ff0000ff"
key ctrl+z
expect clean
# The scenes that are not open follow too: they are written at once, and the dialog says so.
click "hierarchy/Gate"
expect widget prop/startsOpen
click prop/startsOpen
click inspector/prefab/apply
expect file-contains prefabs/mechanisms/gate.ykprefab "\"startsOpen\": true"
expect file-lacks scenes/practice.ykscene "\"startsOpen\": true"
menu "Entity/Prefab/Update Other Instances"
expect dialog confirm
expect dialog-text "scenes/practice.ykscene"
expect dialog-text "cannot be undone"
capture ${SHOT_DIR}/edit-04-update-closed.bmp
click dialog/Confirm/cancel
expect file-lacks scenes/practice.ykscene "\"startsOpen\": true"
menu "Entity/Prefab/Update Other Instances"
click dialog/Confirm/ok
expect no-dialog
expect file-contains scenes/practice.ykscene "\"startsOpen\": true"
expect console "that were not open were saved"
key ctrl+z
expect clean
click "hierarchy/Lever"
# A part of an instance points back at its instance.
menu "Entity/Prefab/Unpack Prefab"
expect dirty
expect no-widget inspector/prefab/revert
key ctrl+z
expect widget inspector/prefab/revert
menu "Entity/Prefab/Show Prefab in Explorer"
expect side-view explorer
expect asset prefabs/mechanisms/lever.ykprefab
click activity/Scene
expect side-view scene

log "== prefab from the selection, then instantiate it from the Prefabs view"
click "hierarchy/Lever"
menu "Entity/Save as Prefab"
expect dialog saveprefab
key ctrl+a
type prefabs/my_lever
click dialog/SavePrefab/ok
expect no-dialog
expect file prefabs/my_lever.ykprefab exists
click activity/Prefabs
expect side-view Prefabs
expect widget asset/prefabs/my_lever.ykprefab
doubleclick asset/prefabs/my_lever.ykprefab
expect entity-count 174
expect dirty
click activity/Scene
expect side-view Scene

log "== scenes open in tabs; edits stay with their tab"
menu "File|Open Scene|scenes/practice.ykscene"
expect scene scenes/practice.ykscene
expect scene-tabs 2
expect scene-open scenes/level01.ykscene
expect widget tab/practice.ykscene
expect widget tab/level01.ykscene
expect clean
click tab/level01.ykscene
expect scene scenes/level01.ykscene
expect dirty
expect entity-count 174

log "== unsaved changes are never lost silently"
click tab/practice.ykscene
expect scene scenes/practice.ykscene
key ctrl+w
expect scene-closed scenes/practice.ykscene
expect scene scenes/level01.ykscene
key ctrl+w
expect dialog unsaved
click dialog/Unsaved/cancel
expect no-dialog
expect scene scenes/level01.ykscene
expect dirty
menu "File/Save All"
expect clean
menu "File|Open Scene|scenes/practice.ykscene"
expect scene-tabs 2

log "== validation and project settings"
# The lever instantiated from the new prefab has no targets, and the Problems panel says so.
menu "Build/Validate Project"
expect panel-view Problems
expect problems 1
# Clicking a problem shows what it is about: the scene opens with that entity selected.
expect widget problems/row/0
expect scene scenes/practice.ykscene
click problems/row/0
expect scene scenes/level01.ykscene
expect selected "Lever (1)"
click "panel-tab/Console"
expect panel-view Console
menu "File/Project Settings"
expect dialog settings
click dialog/Settings/save
expect no-dialog
capture ${SHOT_DIR}/edit-03-playground.bmp

log "== closing the window with unsaved changes asks first"
create Level/Platform
expect dirty
closewindow
expect dialog unsaved
click dialog/Unsaved/cancel
expect no-dialog
expect editing
closewindow
expect dialog unsaved
click dialog/Unsaved/discard
# The editor closes itself now.
expect quitting
