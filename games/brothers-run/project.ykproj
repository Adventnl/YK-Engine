{
  "format": "yk.project",
  "version": 1,
  "name": "Brothers Run",
  "startScene": "scenes/menu.ykscene",
  "window": {
    "title": "Brothers Run",
    "width": 1280,
    "height": 720
  },
  "layers": [
    {
      "name": "Default",
      "interactsWith": [
        "Default"
      ]
    },
    {
      "name": "Solid",
      "interactsWith": [
        "Player",
        "Prop"
      ]
    },
    {
      "name": "Player",
      "interactsWith": [
        "Solid",
        "Sensor",
        "Prop",
        "Player"
      ]
    },
    {
      "name": "Sensor",
      "interactsWith": [
        "Player",
        "Prop"
      ]
    },
    {
      "name": "Prop",
      "interactsWith": [
        "Solid",
        "Player",
        "Sensor",
        "Prop"
      ]
    }
  ],
  "textures": {
    "pixelsPerUnit": 64,
    "filter": "linear"
  },
  "input": {
    "sets": [
      {
        "name": "Player1",
        "gamepad": 0,
        "actions": [
          {
            "name": "MoveLeft",
            "bindings": [
              "Key:A",
              "Pad:DPadLeft",
              "PadAxis:LeftX-"
            ]
          },
          {
            "name": "MoveRight",
            "bindings": [
              "Key:D",
              "Pad:DPadRight",
              "PadAxis:LeftX+"
            ]
          },
          {
            "name": "Jump",
            "bindings": [
              "Key:W",
              "Pad:South"
            ]
          },
          {
            "name": "Interact",
            "bindings": [
              "Key:S",
              "Key:E",
              "Pad:West"
            ]
          }
        ]
      },
      {
        "name": "Player2",
        "gamepad": 1,
        "actions": [
          {
            "name": "MoveLeft",
            "bindings": [
              "Key:Left",
              "Pad:DPadLeft",
              "PadAxis:LeftX-"
            ]
          },
          {
            "name": "MoveRight",
            "bindings": [
              "Key:Right",
              "Pad:DPadRight",
              "PadAxis:LeftX+"
            ]
          },
          {
            "name": "Jump",
            "bindings": [
              "Key:Up",
              "Pad:South"
            ]
          },
          {
            "name": "Interact",
            "bindings": [
              "Key:Down",
              "Key:RightCtrl",
              "Pad:West"
            ]
          }
        ]
      },
      {
        "name": "Global",
        "gamepad": 0,
        "actions": [
          {
            "name": "Restart",
            "bindings": [
              "Key:R",
              "Pad:Back"
            ]
          },
          {
            "name": "Pause",
            "bindings": [
              "Key:P",
              "Pad:Start"
            ]
          },
          {
            "name": "Continue",
            "bindings": [
              "Key:Enter",
              "Pad:East"
            ]
          },
          {
            "name": "Menu",
            "bindings": [
              "Key:M",
              "Pad:Back"
            ]
          },
          {
            "name": "Level1",
            "bindings": [
              "Key:Num1",
              "Pad:South"
            ]
          },
          {
            "name": "Level2",
            "bindings": [
              "Key:Num2",
              "Pad:North"
            ]
          }
        ]
      }
    ]
  },
  "build": {
    "productName": "Brothers Run",
    "executable": "BrothersRun",
    "version": "1.0.0",
    "identifier": "com.ykengine.brothersrun",
    "icon": "assets/icon.png",
    "copyright": "Demo game made with YK Engine",
    "exclude": [
      "assets/reference/png/terrain",
      "assets/reference/png/platforms",
      "assets/reference/png/props/center_lever.png",
      "assets/reference/png/props/center_lever.png.ykmeta",
      "assets/reference/png/props/left_red_button.png",
      "assets/reference/png/props/left_red_button.png.ykmeta"
    ]
  }
}
