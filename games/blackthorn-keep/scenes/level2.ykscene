            "setFlag": "l2_met_mara"
          }
        },
        {
          "type": "Dialogue",
          "properties": {
            "speaker": "Mara",
            "pages": [
              "Welcome to the inner keep. The green exit is south of the east yard. Its power is cut, and a chain holds it shut.",
              "Find a screwdriver and wire cutters in the workshop. Pry open the stores for a fuse and take linen from the laundry. Wrap them at the repair bench.",
              "Steal the security card from control while the guard is away. Match the utility terminal wires, cut the exit chain, then walk south."
            ],
            "portrait": "assets/level2/portrait_companion.png",
            "charactersPerSecond": 0
          }
        }
