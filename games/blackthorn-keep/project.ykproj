{
  "format": "yk.project",
  "version": 1,
  "name": "Blackthorn Keep",
  "startScene": "scenes/menu.ykscene",
  "window": {
    "title": "Blackthorn Keep",
    "width": 1280,
    "height": 720
  },
  "layers": [
    {
      "name": "Default",
      "interactsWith": [
        "Default"
      ]
    },
    {
      "name": "Solid",
      "interactsWith": [
        "Player",
        "Prop"
      ]
    },
    {
      "name": "Player",
      "interactsWith": [
        "Solid",
        "Sensor",
        "Prop"
      ]
    },
    {
      "name": "Sensor",
      "interactsWith": [
        "Player",
        "Prop"
      ]
    },
    {
      "name": "Prop",
      "interactsWith": [
        "Solid",
        "Player",
        "Sensor",
        "Prop"
      ]
    }
  ],
  "textures": {
    "pixelsPerUnit": 35,
    "filter": "nearest"
  },
  "input": {
    "sets": [
      {
        "name": "Player1",
        "gamepad": 0,
        "actions": [
          {
            "name": "MoveLeft",
            "bindings": [
              "Key:A",
              "Key:Left",
              "Pad:DPadLeft",
              "PadAxis:LeftX-"
            ]
          },
          {
            "name": "MoveRight",
            "bindings": [
              "Key:D",
              "Key:Right",
              "Pad:DPadRight",
              "PadAxis:LeftX+"
            ]
          },
          {
            "name": "MoveUp",
            "bindings": [
              "Key:W",
              "Key:Up",
              "Pad:DPadUp",
              "PadAxis:LeftY-"
            ]
          },
          {
            "name": "MoveDown",
            "bindings": [
              "Key:S",
              "Key:Down",
              "Pad:DPadDown",
              "PadAxis:LeftY+"
            ]
          },
          {
            "name": "Interact",
            "bindings": [
              "Key:E",
              "Key:Space",
              "Pad:West"
            ]
          }
        ]
      },
      {
        "name": "Player2",
        "gamepad": 1,
        "actions": [
          {
            "name": "MoveLeft",
            "bindings": [
              "Key:Left",
              "Pad:DPadLeft",
              "PadAxis:LeftX-"
            ]
          },
          {
            "name": "MoveRight",
            "bindings": [
              "Key:Right",
              "Pad:DPadRight",
              "PadAxis:LeftX+"
            ]
          },
          {
            "name": "Jump",
            "bindings": [
              "Key:Up",
              "Pad:South"
            ]
          },
          {
            "name": "Interact",
            "bindings": [
              "Key:Down",
              "Key:RightCtrl",
              "Pad:West"
            ]
          }
        ]
      },
      {
        "name": "Global",
        "gamepad": 0,
        "actions": [
          {
            "name": "Restart",
            "bindings": [
              "Key:R"
            ]
          },
          {
            "name": "Pause",
            "bindings": [
              "Key:P",
              "Pad:Start"
            ]
          },
          {
            "name": "Cancel",
            "bindings": [
              "Key:Escape",
              "Pad:East"
            ]
          },
          {
            "name": "Menu",
            "bindings": [
              "Key:M",
              "Pad:Back"
            ]
          },
          {
            "name": "LevelSelect",
            "bindings": [
              "Key:Tab"
            ]
          },
          {
            "name": "Help",
            "bindings": [
              "Key:H"
            ]
          },
          {
            "name": "Continue",
            "bindings": [
              "Key:Enter",
              "Pad:South"
            ]
          },
          {
            "name": "Level1",
            "bindings": [
              "Key:Num1",
              "Pad:South"
            ]
          },
          {
            "name": "Level2",
            "bindings": [
              "Key:Num2",
              "Pad:North"
            ]
          },
          {
            "name": "PauseUp",
            "bindings": [
              "Key:Up",
              "Key:W",
              "Pad:DPadUp"
            ]
          },
          {
            "name": "PauseDown",
            "bindings": [
              "Key:Down",
              "Key:S",
              "Pad:DPadDown"
            ]
          }
        ]
      }
    ]
  },
  "build": {
    "productName": "Blackthorn Keep",
    "executable": "",
    "version": "1.0.0",
    "identifier": "",
    "copyright": "Blackthorn Keep",
    "exclude": [
      "assets/level2/source",
      "assets/keep/source",
      "tools",
      ".impeccable",
      "reference-style-preview.png",
      "level2-dialogue-preview.png",
      "assets/castle/source",
      "level1-preview.png",
      "level2-preview.png",
      "level2-overview.png",
      "level2-corridor-preview.png",
      "tests",
      "CMakeLists.txt",
      "source"
    ]
  }
}
