# The exploration project uses the stock editor's hierarchy, inspector, asset picker and Play.
timeout 180
expect project "Invisible Castle"
expect scene scenes/menu.ykscene
expect entity "Play Button"
click activity/Explorer
doubleclick assets/folder/scenes
doubleclick asset/scenes/level2.ykscene
expect scene scenes/level2.ykscene
click activity/Scene
expect problems 0
expect entity Mara
expect entity "Green exit gate"
click "hierarchy/Mara"
expect selected Mara
expect widget prop/animation/browse
click prop/animation/browse
expect widget pick/assets/level2/companion.ykanim
key escape
click "hierarchy/Green exit gate"
expect selected "Green exit gate"
expect widget prop/unlockFlag
expect widget prop/persistFlag
click toolbar/Play
expect playing
wait 10
click toolbar/Stop
expect editing
expect clean
quit
