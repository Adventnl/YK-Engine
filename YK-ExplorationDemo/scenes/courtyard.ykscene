          "type": "Dialogue",
          "properties": {
            "speaker": "Mara",
            "pages": [
              "The warden has sealed Blackthorn Keep. At dusk, the east drain leads out beneath the castle wall.",
              "Find a screwdriver in the workshop. Pry open the stores for rope, and take an iron hook from the laundry. Tie them at the workbench.",
              "The brass key is on the warden desk. Wait for the guard to walk away, then search it. Open the east gate and climb down the drain."
            ],
            "charactersPerSecond": 0,
            "portrait": "assets/level2/portrait_companion.png"
          }
        }
